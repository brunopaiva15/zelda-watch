# Copie ce fichier en .env (même dossier que zelda_watch.py) et remplis au moins une méthode.

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── ntfy (push gratuit, app iOS/Android « ntfy ») ──
# Choisis un nom de topic difficile à deviner, ex. bruno-zelda-7k2q9x
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# ── Réglages ──
INTERVAL_MIN=5        # minutes entre deux passages
REMIND_MIN=30         # rappel tant que c'est en stock (0 = désactivé)
MAX_PRICE=130         # ignore les offres plus chères (revendeurs)
MIN_PRICE=50          # ignore les offres annexes moins chères (services, accessoires)
ENGINES=chromium,firefox,webkit  # ordre des navigateurs essayés si un site bloque
CONFIRM=1             # 2e lecture avant chaque alerte (0 = off)
BACKOFF_AFTER=3       # site bloqué N fois de suite…
BACKOFF_EVERY=4       # … n'est plus retenté qu'1 passage sur N
FAIL_ALERT_PASSES=6   # alerte « site non surveillé » après N échecs

# Sites non surveillables (anti-bot) : leurs liens sont ajoutés à chaque alerte, pour vérifier en un clic
MANUAL_SITES=Interdiscount,Fnac

# ── Répartition Mac / GitHub (noms séparés par des virgules) ──
# ONLY_SITES=Interdiscount,Fnac   # ne surveiller que ceux-là (ex. sur ton Mac)
# SKIP_SITES=                     # ignorer ceux-là
MACOS_NOTIF=1         # notification macOS (Mac uniquement)
HEADLESS=1            # 0 = voir le navigateur (debug)
