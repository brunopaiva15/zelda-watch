# Copie ce fichier en .env (même dossier que zelda_watch.py) et remplis au moins une méthode.

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── ntfy (push gratuit, app iOS/Android « ntfy ») ──
# Choisis un nom de topic difficile à deviner, ex. bruno-zelda-7k2q9x
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# ── Réglages ──
INTERVAL_MIN=5        # minutes entre deux passages
REMIND_MIN=30         # rappel tant que c'est en stock (0 = désactivé)
FAIL_ALERT_PASSES=12  # alerte si un site bloque pendant N passages
MACOS_NOTIF=1         # notification macOS (Mac uniquement)
HEADLESS=1            # 0 = voir le navigateur (debug)
